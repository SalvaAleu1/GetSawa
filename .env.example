# ==============================================================================
# GetSawa — Environment Configuration
# Copy this file to .env, fill in real values, and never commit .env.
# Blank provider credentials intentionally keep dependent products unavailable.
# ==============================================================================
NODE_ENV=production
APP_URL=https://getsawa.app
APP_NAME=GetSawa
SESSION_SECRET=                     # 32+ char random secret
DATABASE_URL=postgresql://user:password@host:5432/getsawa?sslmode=require

# Cloudflare scheduled jobs. Use a strong random value and configure the same
# secret in the deployed Worker environment; cron endpoints reject requests
# without this Bearer secret.
CRON_SECRET=

# One-time first-admin bootstrap; remove immediately after use.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Registrar
NAMESILO_API_KEY=
NAMESILO_API_BASE_URL=https://www.namesilo.com/api
NAMESILO_SANDBOX=false

# Payments
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GetSawa <no-reply@getsawa.app>"

# Web hosting — cPanel/WHM API 1.
# WHM_BASE_URL must be the HTTPS WHM server/control-plane origin, commonly
# https://host.example.com:2087. WHM_USERNAME is the reseller/root account used
# by GetSawa and WHM_API_TOKEN is its API token. Never commit the real token.
# After configuring or rotating any value, run Admin > Providers > cPanel / WHM
# > Test live connection. Hosting products remain unavailable until the live
# test verifies credentials, creatable packages and bandwidth-reporting access.
WHM_BASE_URL=
WHM_USERNAME=
WHM_API_TOKEN=

# Business email/mailbox provider — Phase 16. Keep blank until a real provider
# integration is configured and verified.
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

# Privileged-account hardening. Set true only after admin MFA enrollment.
REQUIRE_ADMIN_MFA=false

# AI website builder
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
WEBSITE_HOSTING_TARGET=sites.getsawa.app

# Object storage
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

# Analytics
ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=

# Rate limiting (single-instance fallback; use a shared store for multi-instance)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
