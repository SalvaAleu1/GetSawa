# ==============================================================================
# GetSawa — Environment Configuration
# Copy this file to .env, fill in real values, and never commit .env.
# Blank provider credentials intentionally keep dependent products unavailable.
# ==============================================================================
NODE_ENV=production
APP_URL=https://getsawa.app
APP_NAME=GetSawa
SESSION_SECRET=
DATABASE_URL=postgresql://user:password@host:5432/getsawa?sslmode=require
CRON_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Registrar
NAMESILO_API_KEY=
NAMESILO_API_BASE_URL=https://www.namesilo.com/api
NAMESILO_SANDBOX=false

# Payments
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GetSawa <no-reply@getsawa.app>"

# Web hosting — cPanel/WHM API 1
WHM_BASE_URL=
WHM_USERNAME=
WHM_API_TOKEN=

# Business email — OpenSRS Hosted Email
OPENSRS_EMAIL_CLUSTER=A
OPENSRS_EMAIL_ADMIN_USER=
OPENSRS_EMAIL_ADMIN_PASSWORD=
OPENSRS_EMAIL_COMPANY=
OPENSRS_EMAIL_API_BASE_URL=

# Cloudflare customer security / DNS / CDN / Universal SSL.
# Use a scoped API token for the account GetSawa manages. Required capabilities
# include zone read/create/edit, DNS edit, zone settings edit and DNSSEC edit.
# After configuring or rotating either value, run the live provider test in
# Admin > Providers. Security products remain fail-closed until it succeeds.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

REQUIRE_ADMIN_MFA=false

# AI website builder
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
WEBSITE_HOSTING_TARGET=sites.getsawa.app

# Object storage
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
