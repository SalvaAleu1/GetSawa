# ==============================================================================
# GetSawa — Environment Configuration
# Copy this file to .env, fill in real values, and never commit .env.
# Blank provider credentials intentionally keep dependent products unavailable.
# ==============================================================================
NODE_ENV=production
APP_URL=https://getsawa.app
APP_NAME=GetSawa
SESSION_SECRET=                     # 32+ char random secret
DATABASE_URL=postgresql://user:password@host:5432/getsawa?sslmode=require

# One-time first-admin bootstrap; remove immediately after use.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Registrar
NAMESILO_API_KEY=
NAMESILO_API_BASE_URL=https://www.namesilo.com/api
NAMESILO_SANDBOX=false

# Payments
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GetSawa <no-reply@getsawa.app>"

# Traditional web hosting provider — must be a real provider REST API.
HOSTING_PROVIDER=
HOSTING_API_KEY=
HOSTING_API_BASE_URL=

# Business email/mailbox provider — must be a real provider API.
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

# Privileged-account hardening. Set true only after admin MFA enrollment.
REQUIRE_ADMIN_MFA=false

# AI website builder
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
WEBSITE_HOSTING_TARGET=sites.getsawa.app

# Object storage
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

# Analytics
ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=

# Rate limiting (single-instance fallback; use a shared store for multi-instance)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
