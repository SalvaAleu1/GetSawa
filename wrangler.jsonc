{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getsawa",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "GetSawa",
    "CLOUDFLARE_WORKER_SERVICE_NAME": "getsawa"
  },
  "triggers": {
    "crons": [
      "17 * * * *",
      "37 * * * *",
      "*/10 * * * *",
      "13 * * * *",
      "*/15 * * * *",
      "23 6 * * *",
      "*/5 * * * *",
      "7 */6 * * *",
      "*/6 * * * *",
      "9,39 * * * *",
      "41 3 * * *",
      "31 2 * * *"
    ]
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "APP_NAME": "GetSawa",
        "CLOUDFLARE_WORKER_SERVICE_NAME": "getsawa-staging"
      },
      "triggers": {
        "crons": [
          "17 * * * *",
          "37 * * * *",
          "*/10 * * * *",
          "13 * * * *",
          "*/15 * * * *",
          "23 6 * * *",
          "*/5 * * * *",
          "7 */6 * * *",
          "*/6 * * * *",
          "9,39 * * * *",
          "41 3 * * *",
          "31 2 * * *"
        ]
      }
    }
  }
}
