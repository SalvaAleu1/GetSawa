{
  "name": "getsawa",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=18.18.0" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "setup:admin": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "build:cloudflare": "opennextjs-cloudflare build",
    "build:cloudflare:staging": "opennextjs-cloudflare build --env=staging",
    "build:cloudflare:production": "opennextjs-cloudflare build --env=production",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:cloudflare:staging": "opennextjs-cloudflare build --env=staging && opennextjs-cloudflare preview --env=staging",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cloudflare:staging": "bash scripts/ops/deploy-cloudflare.sh staging",
    "deploy:cloudflare:production": "bash scripts/ops/deploy-cloudflare.sh production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf-typegen:staging": "wrangler types --env=staging --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf-typegen:production": "wrangler types --env=production --env-interface CloudflareEnv cloudflare-env.d.ts",
    "ops:launch-readiness": "node scripts/ops/check-launch-readiness.mjs",
    "ops:monitor-production": "bash scripts/ops/monitor-production.sh",
    "ops:provider-resilience": "node scripts/ops/check-provider-resilience.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "15.5.24",
    "nodemailer": "^6.9.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "prisma": "^5.20.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1",
    "wrangler": "^4.129.1"
  }
}
