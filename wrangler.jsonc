{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudsawa",
  "main": "./cloudflare-worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "preview",
    "APP_NAME": "CloudSawa",
    "CLOUDFLARE_WORKER_SERVICE_NAME": "cloudsawa",
    "APP_URL": "https://cloudsawa.aleuwol12.workers.dev",
    "WEBSITE_PLATFORM_HOST": "cloudsawa.aleuwol12.workers.dev"
  },
  "env": {
    "staging": {
      "name": "cloudsawa-staging",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "APP_NAME": "CloudSawa",
        "CLOUDFLARE_WORKER_SERVICE_NAME": "cloudsawa-staging",
        "APP_URL": "https://cloudsawa-staging.aleuwol12.workers.dev",
        "WEBSITE_PLATFORM_HOST": "cloudsawa-staging.aleuwol12.workers.dev"
      }
    }
  }
}
