# ==============================================================================
# GetSawa — Environment Configuration
# Copy this file to .env, fill in real values, and never commit .env.
# Any integration whose variables are left blank will be treated as
# "not configured" and the related features will fail safe in the UI.
# ==============================================================================

# ---------- APPLICATION ------------------------------------------------------
NODE_ENV=production
APP_URL=https://getsawa.app
APP_NAME=GetSawa
SESSION_SECRET=                     # 32+ char random string, e.g. `openssl rand -hex 32`

# ---------- DATABASE ----------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/getsawa?sslmode=require

# ---------- FIRST ADMIN SETUP --------------------------------------------------
# Used only once by `npm run setup:admin`. Leave blank after first use.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ---------- NAMESILO (primary domain wholesale provider) ----------------------
# https://www.namesilo.com/api-reference
NAMESILO_API_KEY=
NAMESILO_API_BASE_URL=https://www.namesilo.com/api
NAMESILO_SANDBOX=false

# ---------- PAYPAL --------------------------------------------------------------
# https://developer.paypal.com/api/rest/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live                     # live | sandbox
PAYPAL_BASE_URL=https://api-m.paypal.com   # use https://api-m.sandbox.paypal.com for sandbox
PAYPAL_WEBHOOK_ID=                   # from PayPal Developer Dashboard > Webhooks

# ---------- EMAIL (transactional) -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GetSawa <no-reply@getsawa.app>"

# ---------- HOSTING PROVIDER (Phase 2 — optional) --------------------------------
HOSTING_PROVIDER=                    # leave blank until a provider is integrated
HOSTING_API_KEY=
HOSTING_API_BASE_URL=

# ---------- EMAIL HOSTING PROVIDER (Phase 2 — optional) --------------------------
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=

# ---------- AI PROVIDER (Phase 2/3 — optional, powers AI website builder) --------
# Powers the AI Website Builder. Uses the Anthropic Messages API by default —
# get a key from https://console.anthropic.com. See docs/AI_BUILDER.md.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# ---------- AI WEBSITE BUILDER — DOMAIN CONNECTION -------------------------------
# Hostname customers' CNAME records are pointed at when they connect a domain
# to an AI-built site. Point your own DNS for this hostname at wherever this
# app is actually deployed.
WEBSITE_HOSTING_TARGET=sites.getsawa.app

# ---------- OBJECT STORAGE -------------------------------------------------------
STORAGE_PROVIDER=                    # s3 | r2 | gcs — leave blank to disable uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

# ---------- ANALYTICS -------------------------------------------------------------
ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=

# ---------- SECURITY ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
