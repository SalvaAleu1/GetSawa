# ==============================================================================
# GetSawa — Environment Configuration
# Copy this file to .env, fill in real values, and never commit .env.
# Blank provider credentials intentionally keep dependent products unavailable.
# ==============================================================================
NODE_ENV=production
APP_URL=https://getsawa.app
APP_NAME=GetSawa
SESSION_SECRET=
DATABASE_URL=postgresql://user:password@host:5432/getsawa?sslmode=require
CRON_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
SUPPORT_EMAIL=

# Provider routing. Only provider names with implemented adapters are accepted.
DOMAIN_PROVIDER=namesilo
DOMAIN_SECONDARY_PROVIDER=
PAYMENT_PROVIDER=paypal
PAYMENT_SECONDARY_PROVIDER=
HOSTING_PROVIDER=whm
HOSTING_SECONDARY_PROVIDER=
EMAIL_PROVIDER=opensrs
EMAIL_SECONDARY_PROVIDER=
SECURITY_PROVIDER=cloudflare
SECURITY_SECONDARY_PROVIDER=
PUBLISHING_PROVIDER=cloudflare
PUBLISHING_SECONDARY_PROVIDER=
AI_SECONDARY_PROVIDER=
# Comma-separated capability names such as "payments" or "domains,payments".
# Leave blank unless each selected capability has two implemented/tested adapters.
PROVIDER_AUTOMATIC_FAILOVER_CAPABILITIES=
PROVIDER_FAILOVER_APPROVAL_ID=

# Market expansion allow-lists. These do not by themselves enable checkout in a
# new currency or publish a locale; see docs/operations/MARKET_EXPANSION.md.
GETSAWA_SUPPORTED_CURRENCIES=USD
GETSAWA_SUPPORTED_LOCALES=en

# Registrar
NAMESILO_API_KEY=
NAMESILO_API_BASE_URL=https://www.namesilo.com/api
NAMESILO_SANDBOX=false

# Payments
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GetSawa <no-reply@getsawa.app>"

# Web hosting — cPanel/WHM API 1
WHM_BASE_URL=
WHM_USERNAME=
WHM_API_TOKEN=

# Business email — OpenSRS Hosted Email
OPENSRS_EMAIL_CLUSTER=A
OPENSRS_EMAIL_ADMIN_USER=
OPENSRS_EMAIL_ADMIN_PASSWORD=
OPENSRS_EMAIL_COMPANY=
OPENSRS_EMAIL_API_BASE_URL=

# Cloudflare customer DNS/CDN and Worker publishing.
# The token must cover the GetSawa account and the customer zones it manages.
# Phase 17 uses zone/DNS/settings/DNSSEC permissions; Phase 19 additionally
# requires Workers Scripts Write so Worker Custom Domains can be attached.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_SERVICE_NAME=getsawa
# Host that represents the primary GetSawa application and must never be
# interpreted as a customer site by host-routing middleware.
WEBSITE_PLATFORM_HOST=getsawa.app

REQUIRE_ADMIN_MFA=false

# AI website builder
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# Object storage. Direct upload UI remains disabled until a provider is wired.
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_ENDPOINT=

ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
